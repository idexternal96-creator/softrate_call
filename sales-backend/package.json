{
  "name": "sales-backend-wrapper",
  "version": "1.0.0",
  "private": true,
  "description": "Compatibility wrapper for deployments that point at softrate_call/sales-backend.",
  "main": "../server.js",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "scripts": {
    "start": "cd .. && NODE_PATH=sales-backend/node_modules node server.js",
    "dev": "cd .. && NODE_PATH=sales-backend/node_modules nodemon server.js",
    "indexes:lead": "cd .. && NODE_PATH=sales-backend/node_modules node scripts/ensureLeadIndexes.js",
    "test": "cd .. && NODE_PATH=sales-backend/node_modules node --test"
  },
  "dependencies": {
    "@langchain/core": "^1.0.6",
    "@langchain/openai": "^1.0.6",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.6",
    "cheerio": "^1.1.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.0.6",
    "mongoose": "^9.2.4",
    "node-cron": "^4.2.1",
    "razorpay": "^2.9.6",
    "resend": "^6.9.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
